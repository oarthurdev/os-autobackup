VPS_HOST=your_vps_ip_or_hostname
VPS_PORT=22
VPS_USERNAME=your_ssh_username
VPS_PASSWORD=your_ssh_password_or_leave_empty_for_key
VPS_KEY_PATH=/path/to/ssh/private/key

BACKUP_PATHS=/home,/etc,/var/www

ENCRYPTION_KEY=your_32_byte_encryption_key_base64

GOOGLE_DRIVE_CREDENTIALS_FILE=credentials.json
GOOGLE_DRIVE_TOKEN_FILE=token.json
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

FLASK_SECRET_KEY=your_flask_secret_key_here
